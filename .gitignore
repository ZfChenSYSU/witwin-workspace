# Local Python environment and caches
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Generated validation output
logs/
pipelines/witwin/experiments/**/outputs/run_stdout.json

# Local experiment datasets. Keep only documentation and intentionally curated
# tiny examples under version control.
datasets/**
!datasets/.gitignore
!datasets/README.md
!datasets/examples/
!datasets/examples/**

# Platform-specific build products and raw captures
apps/ios-recorder/DerivedData/
apps/ios-recorder/.build/
capture/csi-linux/raw/
capture/csi-linux/tmp/

# Workspace research documents are versioned. Keep host-local configuration,
# large OptiX/driver backups, and system-workaround links out of Git.
workspace/host_snapshot/.claude/
workspace/host_snapshot/.witwin-optix-workaround/
workspace/support/

# Local editor and OS metadata
.vscode/
.idea/
.DS_Store
