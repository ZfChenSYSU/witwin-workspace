{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZfChenSYSU/witwin-workspace/schemas/session-format/session.schema.json",
  "title": "WiTwin multimodal capture session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "capture_stage",
    "created_at",
    "devices",
    "assembly",
    "timebases",
    "files"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.3.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "source",
          "capture"
        ],
        "properties": {
          "capture": {
            "required": [
              "video",
              "arkit",
              "motion"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capture_stage": {
            "enum": [
              "phone_csi_p2",
              "unified_p4"
            ]
          }
        },
        "required": [
          "capture_stage"
        ]
      },
      "then": {
        "properties": {
          "devices": {
            "required": [
              "phone",
              "csi_receiver"
            ]
          },
          "assembly": {
            "required": [
              "phone_assembly_id",
              "receiver_assembly_id"
            ]
          },
          "timebases": {
            "required": [
              "phone",
              "csi"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capture_stage": {
            "const": "phone_udp_p2"
          }
        },
        "required": [
          "capture_stage"
        ]
      },
      "then": {
        "required": [
          "capture"
        ],
        "properties": {
          "capture": {
            "required": [
              "udp"
            ]
          },
          "files": {
            "contains": {
              "type": "object",
              "properties": {
                "role": {
                  "const": "udp_transmit_log"
                }
              },
              "required": [
                "role"
              ]
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.2.0",
        "1.3.0"
      ]
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "capture_stage": {
      "enum": [
        "phone_only_p1",
        "phone_udp_p2",
        "phone_csi_p2",
        "unified_p4"
      ]
    },
    "status": {
      "enum": [
        "recording",
        "completed",
        "interrupted",
        "failed",
        "validation_failed"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_commit",
        "build_identifier"
      ],
      "properties": {
        "workspace_commit": {
          "$ref": "#/$defs/gitCommitOrUnknown"
        },
        "build_identifier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "witwin_core_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "witwin_channel_commit": {
          "$ref": "#/$defs/gitCommit"
        }
      }
    },
    "devices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phone"
      ],
      "properties": {
        "phone": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "model",
            "os_version"
          ],
          "properties": {
            "model": {
              "type": "string"
            },
            "os_version": {
              "type": "string"
            },
            "app_version": {
              "type": "string"
            },
            "wifi_mac_observed": {
              "$ref": "#/$defs/macAddress"
            }
          }
        },
        "csi_receiver": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "nic_model",
            "capture_software"
          ],
          "properties": {
            "nic_model": {
              "type": "string"
            },
            "capture_software": {
              "type": "string"
            }
          }
        }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "phone_assembly_id"
      ],
      "properties": {
        "phone_assembly_id": {
          "type": "string"
        },
        "receiver_assembly_id": {
          "type": "string"
        }
      }
    },
    "timebases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phone"
      ],
      "properties": {
        "phone": {
          "$ref": "#/$defs/timebase"
        },
        "csi": {
          "$ref": "#/$defs/timebase"
        },
        "phone_to_csi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clock_scale",
            "clock_offset_ns",
            "fit_samples",
            "residual_rms_ns"
          ],
          "properties": {
            "clock_scale": {
              "type": "number"
            },
            "clock_offset_ns": {
              "type": "number"
            },
            "fit_samples": {
              "type": "integer",
              "minimum": 2
            },
            "residual_rms_ns": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "coordinate_convention": {
      "type": "string",
      "const": "schemas/session-format/coordinate_frames.md"
    },
    "capture": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "started_monotonic_seconds": {
          "type": "number",
          "minimum": 0
        },
        "ended_monotonic_seconds": {
          "type": "number",
          "minimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "video_frame_count": {
          "type": "integer",
          "minimum": 0
        },
        "video_dropped_frame_count": {
          "type": "integer",
          "minimum": 0
        },
        "ar_frame_count": {
          "type": "integer",
          "minimum": 0
        },
        "face_anchor_sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "imu_sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "video": {
          "$ref": "#/$defs/videoSemantics"
        },
        "arkit": {
          "$ref": "#/$defs/arkitSemantics"
        },
        "motion": {
          "$ref": "#/$defs/motionSemantics"
        },
        "udp": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "target_host",
            "target_port",
            "configured_bitrate_bits_per_second",
            "datagram_bytes",
            "attempted_packet_count",
            "successful_packet_count",
            "failed_packet_count",
            "achieved_bitrate_bits_per_second"
          ],
          "properties": {
            "target_host": {
              "type": "string"
            },
            "target_port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "configured_bitrate_bits_per_second": {
              "type": "integer",
              "minimum": 1
            },
            "datagram_bytes": {
              "type": "integer",
              "minimum": 32,
              "maximum": 1400
            },
            "attempted_packet_count": {
              "type": "integer",
              "minimum": 0
            },
            "successful_packet_count": {
              "type": "integer",
              "minimum": 0
            },
            "failed_packet_count": {
              "type": "integer",
              "minimum": 0
            },
            "achieved_bitrate_bits_per_second": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gitCommitOrUnknown": {
      "oneOf": [
        {
          "$ref": "#/$defs/gitCommit"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "videoSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codec",
        "container",
        "expected_frame_rate_hz",
        "orientation",
        "mirrored",
        "crop_policy",
        "scaling_policy",
        "stabilization_policy",
        "video_frame_id_semantics"
      ],
      "properties": {
        "codec": { "type": "string" },
        "container": { "type": "string" },
        "source_pixel_format_four_cc": { "type": "string" },
        "expected_frame_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "orientation": { "type": "string" },
        "mirrored": { "type": "boolean" },
        "crop_policy": { "type": "string" },
        "scaling_policy": { "type": "string" },
        "stabilization_policy": { "type": "string" },
        "video_frame_id_semantics": {
          "const": "zero_based_successful_asset_writer_sample_index"
        }
      }
    },
    "arkitSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pose_field_prefix",
        "transform_convention",
        "matrix_layout",
        "coordinate_system",
        "length_unit",
        "intrinsics_matrix_layout",
        "intrinsics_reference"
      ],
      "properties": {
        "pose_field_prefix": { "type": "string" },
        "transform_convention": { "const": "target_T_source" },
        "matrix_layout": { "const": "row_major" },
        "coordinate_system": { "type": "string" },
        "length_unit": { "const": "m" },
        "intrinsics_matrix_layout": { "const": "row_major" },
        "intrinsics_reference": { "type": "string" }
      }
    },
    "motionSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_update_rate_hz",
        "attitude_reference_frame",
        "quaternion_order",
        "raw_samples_interpolated",
        "recorded_streams",
        "streams"
      ],
      "properties": {
        "requested_update_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
        "attitude_reference_frame": { "type": "string" },
        "quaternion_order": { "const": "xyzw" },
        "raw_samples_interpolated": { "const": false },
        "recorded_streams": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "streams": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["unit", "reference_frame"],
            "properties": {
              "unit": { "type": "string" },
              "reference_frame": { "type": "string" }
            }
          }
        }
      }
    },
    "macAddress": {
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$"
    },
    "timebase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock",
        "unit"
      ],
      "properties": {
        "clock": {
          "type": "string"
        },
        "unit": {
          "enum": [
            "ns",
            "s"
          ]
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
